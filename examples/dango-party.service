# systemd 服务：/etc/systemd/system/dango-party.service
#
#   sudo mkdir -p /opt/dango-party
#   sudo cp server.mjs package.json /opt/dango-party/
#   sudo useradd -r -s /usr/sbin/nologin dango
#   sudo chown -R dango:dango /opt/dango-party
#   sudo systemctl enable --now dango-party
#   curl -s http://127.0.0.1:8787/healthz

[Unit]
Description=Dango Music party server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dango-party
ExecStart=/usr/bin/node server.mjs
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DATA_DIR=/opt/dango-party/data

# 不想装 Nginx / Caddy 时，让 node 自己上 TLS：去掉上面的 HOST/PORT，改成下面这几行
#（HOST 要改成 0.0.0.0；443 需要 root 或给 node 加 CAP_NET_BIND_SERVICE，用 8443 最省事）
#Environment=HOST=0.0.0.0
#Environment=PORT=8443
#Environment=TLS_CERT=/etc/letsencrypt/live/party.example.com/fullchain.pem
#Environment=TLS_KEY=/etc/letsencrypt/live/party.example.com/privkey.pem
#ReadOnlyPaths=/etc/letsencrypt

Restart=always
RestartSec=2
User=dango
Group=dango

# 加固：只需要读代码 + 写 data 目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dango-party/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
